{
  "name": "antares2",
  "productName": "Antares2",
  "version": "0.8.8",
  "description": "A modern, fast and productivity driven SQL client with a focus in UX.",
  "license": "MIT",
  "repository": "https://github.com/TW199501/Antares2.git",
  "scripts": {
    "vite:dev": "vite",
    "vite:build": "vite build",
    "sidecar:build:net": "node scripts/build-net-sidecar.mjs",
    "replay:contract": "node scripts/replay-contract.mjs",
    "audit:renderer": "node scripts/audit-renderer-untouched.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/tauri-build.mjs",
    "lint": "eslint . --ext .js,.ts,.vue && stylelint \"./web/**/*.{css,scss,sass,vue}\"",
    "lint:fix": "eslint . --ext .js,.ts,.vue --fix && stylelint \"./web/**/*.{css,scss,sass,vue}\" --fix",
    "type-check": "vue-tsc --noEmit",
    "test:unit": "vitest",
    "test:unit:watch": "vitest watch",
    "test:unit:run": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:coverage:check": "node scripts/check-coverage.mjs",
    "preflight:net": "node scripts/preflight-net.mjs",
    "preflight:dbs": "node scripts/preflight-dbs.mjs",
    "probe:ssh": "node scripts/probe-ssh.mjs",
    "verify:tauri-migration": "node ./scripts/checkTauriMigration.js",
    "check:eol": "node ./scripts/check-eol.mjs",
    "release": "node ./scripts/release.mjs",
    "test:e2e": "npx playwright test",
    "translation:check": "tsx ./scripts/translationCheck.ts",
    "migrate:appdata": "node ./scripts/migrate-appdata.mjs",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "prepare": "husky"
  },
  "author": "TW199501",
  "contributors": [
