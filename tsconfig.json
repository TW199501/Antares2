{
  "include": [
    "./web/renderer/**/*",
    "./web/common/**/*",
    "./web/main/**/*",
    "./vitest.config.ts",
    "./tests/**/*"
  ],
  "exclude": [
    "./web/renderer/libs/ext-language_tools.js",
    "./web/main/ipc-handlers/**/*"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "strict": false,
    "skipLibCheck": true,
    "jsx": "preserve",
    "types": [
      "node",
      "vite/client"
    ],
    "noEmit": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "paths": {
      "common/*": ["./web/common/*"],
      "@/*": ["./web/renderer/*"],
      "@tests/*": ["./tests/*"],
    }
  }
}