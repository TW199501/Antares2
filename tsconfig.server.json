{
   "compilerOptions": {
      "target": "ES2021",
      "module": "CommonJS",
      "moduleResolution": "node",
      "ignoreDeprecations": "6.0",
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "sourceMap": true,
      "noImplicitAny": true,
      "skipLibCheck": true,
      "outDir": "dist-server",
      "paths": {
         "common/*": ["./web/common/*"]
      }
   },
   "include": ["web/main/**/*", "web/common/**/*"],
   "exclude": ["node_modules", "web/main/ipc-handlers/**"]
}
