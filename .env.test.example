# Local DB credentials for preflight:dbs and capture:contract.
# Copy this file to .env.test (gitignored) and fill in real values.
# Used by:
#   - pnpm preflight:dbs  — Phase 0 hard gate (TCP-ping + SELECT 1 against 4 DBs)
#   - pnpm capture:contract — IPC contract fixture capture against a live sidecar
#
# .env.test is gitignored. Never commit real credentials.

# MySQL / MariaDB
DEV_MYSQL_HOST=127.0.0.1
DEV_MYSQL_PORT=3306
DEV_MYSQL_USER=root
DEV_MYSQL_PASSWORD=
DEV_MYSQL_DATABASE=antares_test_fixture

# PostgreSQL
DEV_PG_HOST=127.0.0.1
DEV_PG_PORT=5432
DEV_PG_USER=postgres
DEV_PG_PASSWORD=
DEV_PG_DATABASE=antares_test_fixture

# SQL Server
DEV_MSSQL_HOST=127.0.0.1
DEV_MSSQL_PORT=1433
DEV_MSSQL_USER=sa
DEV_MSSQL_PASSWORD=
DEV_MSSQL_DATABASE=antares_test_fixture

# SQLite (path — not network)
DEV_SQLITE_PATH=./misc/antares_test_fixture.sqlite

# SSH gateway for Phase 1 cipher matrix probe (pnpm probe:ssh).
# Provide either DEV_SSH_KEY_PATH (preferred) OR DEV_SSH_PASSWORD; not both.
DEV_SSH_HOST=
DEV_SSH_PORT=22
DEV_SSH_USER=
DEV_SSH_KEY_PATH=
DEV_SSH_PASSWORD=
